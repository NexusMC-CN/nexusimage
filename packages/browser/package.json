{
  "name": "@nexusmc-cn/nexusimage",
  "version": "0.2.2",
  "description": "Browser-native image loading, resizing, transforms, EXIF parsing and encoding with Canvas and OffscreenCanvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./contracts": {
      "import": {
        "types": "./dist/contracts.d.ts",
        "default": "./dist/contracts.js"
      },
      "require": {
        "types": "./dist/cjs/contracts.d.ts",
        "default": "./dist/contracts.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusMC-CN/nexusimage.git",
    "directory": "packages/browser"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/build-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && node tests/browser.integration.mjs",
    "test:browser:playwright": "npm run build && playwright test",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/**/*.mjs\" \"*.ts\" \"*.json\" README.md CHANGELOG.md",
    "test:ci": "npm run format:check && npm run typecheck && npm test && npm run build && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run test:ci",
    "prepack": "npm run build"
  },
  "keywords": [
    "image",
    "image-processing",
    "image-resize",
    "image-crop",
    "image-compression",
    "image-conversion",
    "browser",
    "canvas",
    "offscreen-canvas",
    "image-bitmap",
    "image-decoder",
    "exif",
    "typescript",
    "jpeg",
    "png",
    "webp",
    "gif",
    "avif"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/NexusMC-CN/nexusimage/blob/main/packages/browser/README.md",
  "bugs": {
    "url": "https://github.com/NexusMC-CN/nexusimage/issues"
  }
}
