{
  "name": "nexusimage",
  "version": "0.2.0",
  "description": "NexusImage: browser-native image loading, EXIF, canvas processing and optimization.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./contracts": {
      "import": {
        "types": "./dist/contracts.d.ts",
        "default": "./dist/contracts.js"
      },
      "require": {
        "types": "./dist/contracts.d.ts",
        "default": "./dist/contracts.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && node tests/browser.integration.mjs",
    "test:browser:playwright": "npm run build && playwright test",
    "test:ci": "npm run typecheck && npm test && npm run build && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run test:ci",
    "prepack": "npm run build"
  },
  "keywords": [
    "image",
    "canvas",
    "offscreen-canvas",
    "exif",
    "image-bitmap",
    "typescript",
    "jpeg",
    "png",
    "webp",
    "gif",
    "avif"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
