{
  "name": "@nexusimage/node",
  "version": "0.1.0",
  "description": "Node.js Sharp adapter for NexusImage image processing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "test:fastify": "vitest run tests/fastify.test.ts",
    "test:ci": "npm run typecheck && npm test && npm run build && npm run pack:check",
    "prepublishOnly": "npm run test:ci",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "fastify-plugin": "^5.1.0",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "fastify": ">=5.0.0 <6.0.0",
    "nexusimage": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fastify": "^5.12.5",
    "nexusimage": "file:../nexusimage",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
